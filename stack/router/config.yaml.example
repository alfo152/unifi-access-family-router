# EN: router configuration for the per-family Docker stack
#     (stack/docker-compose.yml). Copy to config.yaml and fill in the values.
#     Every option, explained: ../../config.example.yaml
# IT: configurazione del router per il pacchetto Docker della famiglia
#     (stack/docker-compose.yml). Copia in config.yaml e compila i valori.
#     Tutte le opzioni, spiegate: ../../config.example.yaml

access:
  host: 192.168.50.1
  token: "PASTE-THE-FAMILY-TOKEN-HERE"
  tls_fingerprint: ""

family:
  name: "Famiglia Rossi"
  id: rossi
  match:
    room_ids:
      - "WR-PASTE-FROM-LEARN-MODE"

mqtt:
  host: mosquitto          # EN: service name in the stack / IT: nome del servizio nel pacchetto
  port: 1883
  username: router
  password: "change-me"

homebridge:
  enabled: true
  topic_prefix: unifi/protect
  camera_mac: "F4:E2:C6:12:34:56"

unlock:
  enabled: false
  # EN/IT: e.g. / es. ["Portone=<door_id>", "Cancello=<door_id>"] (--list-doors)
  doors: []

learn_mode: false
log_level: info
